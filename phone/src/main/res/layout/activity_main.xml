<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Card"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStop"
                style="@style/ButtonDanger"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="@string/stop_mirroring"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Cars -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/cars_nearby" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/carList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/carEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/searching"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/stroke" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_title"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ipInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/ip_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnConnectIp"
                    style="@style/ButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/connect" />
            </LinearLayout>
        </LinearLayout>

        <!-- Setup -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/setup" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <LinearLayout style="@style/SetupRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/touch_title" />

                    <TextView
                        android:id="@+id/touchState"
                        style="@style/RowDetail" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnTouch"
                    style="@style/ButtonOutline"
                    android:text="@string/turn_on" />
            </LinearLayout>

            <TextView
                android:id="@+id/touchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/touch_hint"
                android:textColor="@color/warn"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnAppInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:text="@string/open_app_info"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/SetupRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/location_title" />

                    <TextView
                        android:id="@+id/locationState"
                        style="@style/RowDetail" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLocation"
                    style="@style/ButtonOutline"
                    android:text="@string/allow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notifRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View style="@style/Divider" />

                <LinearLayout style="@style/SetupRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="@string/notif_title" />

                        <TextView
                            android:id="@+id/notifState"
                            style="@style/RowDetail" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnNotif"
                        style="@style/ButtonOutline"
                        android:text="@string/allow" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Settings -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/settings" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <TextView
                style="@style/RowTitle"
                android:text="@string/quality" />

            <RadioGroup
                android:id="@+id/qualityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/qSmooth"
                    style="@style/QualityRadio"
                    android:text="@string/q_smooth" />

                <RadioButton
                    android:id="@+id/qBalanced"
                    style="@style/QualityRadio"
                    android:text="@string/q_balanced" />

                <RadioButton
                    android:id="@+id/qSharp"
                    style="@style/QualityRadio"
                    android:text="@string/q_sharp" />
            </RadioGroup>

            <View style="@style/Divider" />

            <Switch
                android:id="@+id/guardSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guard_title"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/guard_detail"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tips -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/tips" />

        <TextView
            style="@style/Card"
            android:lineSpacingExtra="4dp"
            android:text="@string/tips_body"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
